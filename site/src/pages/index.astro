---
// A placeholder until the landing page is built: the page frame around the one-line pitch.
import PageFrame from "../components/PageFrame.astro";
import { repoUrl } from "../site.ts";
---
<PageFrame>
	<section class="hero">
		<h1>Set the Goal.<br />Go do something else.</h1>
		<p>Vago runs your Workflow on a Goal in your repo, one Ticket at a time, and leaves you a PR.</p>
		<a class="button" href={repoUrl}>Read it on GitHub</a>
	</section>
</PageFrame>

<style>
	.hero {
		padding: var(--v-section) 0 0;
	}
	h1 {
		margin: 0;
		max-width: 12ch;
		font-size: var(--v-fs-display);
		line-height: var(--v-lh-display);
		letter-spacing: var(--v-track-display);
		font-weight: var(--v-weight-head);
		color: var(--v-bright);
	}
	p {
		margin: 28px 0 32px;
		max-width: 40ch;
		font-size: 19px;
	}
	.button {
		display: inline-block;
		padding: 12px 20px;
		border-radius: var(--v-radius);
		background: var(--v-accent-fill);
		color: var(--v-on-accent);
		font-weight: 600;
		text-decoration: none;
		transition: background 0.15s;
	}
	.button:hover {
		background: var(--v-accent-hover);
	}
</style>
