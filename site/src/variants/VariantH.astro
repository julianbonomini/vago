---
// PROTOTYPE, variant H: E's hero walking into F's story. The live TUI fills
// the first screen, pulls back while a spotlight names its panes (E), then
// glides into F's sticky column, where the story's beats drive it. One TUI
// carries all three; h/run.ts moves it. Below: E's pipeline, E's Workflow
// file with F's starter tabs folded in, install, and E's footer on a soft
// shade that the header shares.
import "../shared/tokens.css";
import LiveTui from "../shared/LiveTui.astro";
import ThemeToggle from "../shared/ThemeToggle.astro";
import { beats as fBeats, chapterNames } from "./f/story.ts";
import { starterFiles } from "./h/workflow.ts";

const github = "https://github.com/julianbonomini/vago";

const parts = [
	{ name: "Goals", text: "Every Goal in the Project, with its Tickets done, what it has cost and what it's on now." },
	{ name: "Tickets", text: "Open a Goal and its Tickets run top to bottom. Here 03 is on Build." },
	{ name: "Ticket", text: "The running Ticket: what to build, and the Steps your Workflow gives it." },
	{ name: "Runs", text: "Each time a Step runs is a Run, with its time and cost. A retry is another Run." },
	{ name: "Run activity", text: "What the agent is doing in the live Run: files it writes, tests it runs, what it says." },
];
const keys: [string, string][] = [
	["ArrowUp", "↑"],
	["ArrowDown", "↓"],
	["Enter", "Enter"],
	["Escape", "Esc"],
	["Tab", "Tab"],
	["?", "?"],
];
// The pipeline further down says "one Ticket at a time", so the story
// doesn't say it twice.
const beats = fBeats.map((b) => (b.id === "tickets" ? { ...b, limit: undefined } : b));

// Ticket 03 of the example Goal gift-cards, as the replay shows it.
const steps = [
	{ id: "New branch", type: "shell", took: "0.1s", cost: "" },
	{ id: "Build", type: "agent", took: "9m12s", cost: "$0.86" },
	{ id: "Checks", type: "shell", took: "1m38s", cost: "" },
	{ id: "Review", type: "agent", took: "3m34s", cost: "$0.31" },
	{ id: "Squash merge", type: "shell", took: "5.2s", cost: "" },
];
const tickets = ["01-gift-card-codes", "02-redeem-at-checkout", "03-balance-page", "04-staff-issue-cards", "05-refunds-to-card"];
const commits = [
	["7c41e0a", "02 redeem at checkout"],
	["e19b3f2", "01 gift card codes"],
];
---
<div class="vago-page vh" data-theme="light">
	<header class="vh-top">
		<div class="vh-top-in">
			<a class="vh-word" href="#">vago</a>
			<nav aria-label="Main">
				<a href="#vh-how">How it works</a>
				<a href="#vh-workflow">Workflow</a>
				<a href="#vh-install">Install</a>
				<a href={github}>GitHub</a>
				<ThemeToggle />
			</nav>
		</div>
	</header>

	<section class="vh-stage" data-stage aria-labelledby="vh-title">
		<div class="vh-sticky">
			<div class="vh-copy">
				<h1 id="vh-title">Set the Goal.<br />Go do something else.</h1>
				<div class="vh-copy-side">
					<p class="vh-sub">Vago runs your Workflow on a Goal in your repo, one Ticket at a time, and leaves you a PR.</p>
					<div class="vh-ctas">
						<a class="vh-btn" href="#vh-install">Install</a>
						<a class="vh-link" href="#vh-how">How it works</a>
					</div>
				</div>
			</div>

			<div class="vh-slot" data-slot aria-hidden="true"></div>

			<div class="vh-side" data-side>
				<h2>One screen for every Goal</h2>
				<p class="vh-side-note">A replay of Vago's TUI on an example Project, acme-shop. Nothing here is running.</p>
				<ul class="vh-parts">
					{parts.map((p, i) => (
						<li>
							<button type="button" class="vh-part" data-part={i} aria-pressed="false">
								<span class="vh-part-name">{p.name}</span>
								<span class="vh-part-text"><span>{p.text}</span></span>
							</button>
						</li>
					))}
				</ul>
				<div class="vh-side-keys">
					<p>Or drive it yourself. Click the screen and use its keys, or these.</p>
					<div class="vh-keys" role="group" aria-label="Keys for the TUI">
						{keys.map(([k, label]) => <button type="button" class="vh-key" data-tui-key={k}>{label}</button>)}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="vh-story" id="vh-how" aria-labelledby="vh-story-title">
		<div class="vh-story-grid">
			<div class="vh-beats">
				<header class="vh-phone-head">
					<h2>One screen for every Goal</h2>
					<p>A replay of Vago's TUI on an example Project, acme-shop. Nothing here is running. Scroll, and it shows you each part.</p>
				</header>
				{parts.map((p, i) => (
					<article class="vh-beat vh-phone-beat" data-beat data-spot={i} data-chapter-of="-1">
						<h3>{p.name}</h3>
						<p class="vh-beat-body">{p.text}</p>
					</article>
				))}

				<header class="vh-story-head" data-rise>
					<h2 id="vh-story-title">Stop babysitting your agents</h2>
					<p class="vh-statement">
						You already know how agents should work on your code. You've got the skills, the prompts and the checks. What's left is the sitting: correcting a session, rebriefing the next one when the context fills up, fixing small things by hand.
					</p>
					<p class="vh-proof">Vago builds itself. Most of its own repo came out of Goals run through it.</p>
					<p class="vh-cue">Here's gift-cards, one Goal in acme-shop, from the file you write to the PR you merge. Scroll, and the TUI follows along.</p>
				</header>

				{beats.map((b) => (
					<article
						class={b.short ? "vh-beat vh-beat-short" : "vh-beat"}
						id={`vh-beat-${b.id}`}
						data-beat
						data-chapter-of={b.chapter}
						data-goto={JSON.stringify(b.goto)}
						data-scrub={b.scrub ? b.scrub.join(",") : undefined}
					>
						<h3>{b.title}</h3>
						<p class="vh-beat-body">{b.body}</p>
						{b.limit && <p class="vh-limit-note">{b.limit}</p>}
						<figure class="vh-art">
							<figcaption>{b.file}</figcaption>
							<pre>{b.rows.map((row, r) => (
								<span class="row" style={`--i:${r}`}>{row.map(([cls, text]) => <span class={cls ? `c-${cls}` : undefined}>{text}</span>)}</span>
							))}</pre>
						</figure>
					</article>
				))}
			</div>

			<div class="vh-dock-col" data-dock-col>
				<div class="vh-dock" data-dock>
					<ol class="vh-chapters" aria-label="Where the story is">
						{chapterNames.map((name, i) => (
							<li><button type="button" data-chapter={i}>{name}</button></li>
						))}
					</ol>
					<div class="vh-anchor" data-anchor>
						<div class="vh-fly" data-fly>
							<LiveTui id="vh-tui" class="vh-tui" keys={false} controls={false} caption={false} />
						</div>
					</div>
					<div class="vh-dock-bar">
						<p data-drive aria-live="polite">Scrolling drives it. Click it to take over.</p>
						<div class="vh-keys" role="group" aria-label="Keys for the TUI">
							{keys.map(([k, label]) => <button type="button" class="vh-key" data-tui-key={k}>{label}</button>)}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="vh-how" id="vh-pipeline" aria-labelledby="vh-how-h">
		<div class="vh-how-in">
			<div class="vh-how-head" data-rise>
				<h2 id="vh-how-h">What happens after you leave</h2>
				<p>
					All of gift-cards on one line. You write the Goal and its Tickets, Vago runs the rest, and you come back to a PR. Scroll, and Ticket 03 goes through.
				</p>
			</div>

			<ol class="vh-pipe" data-pipe>
				<span class="vh-rail" aria-hidden="true"><span class="vh-rail-fill"></span></span>
				<li class="vh-stage-i is-lit" data-stage-i>
					<span class="vh-node" aria-hidden="true"></span>
					<h3>Goal</h3>
					<p>You write it.</p>
					<pre class="vh-pre"><span class="row c-d">goal.md</span><span class="row c-x"># Customers can pay</span><span class="row c-x"># with a gift card</span></pre>
				</li>
				<li class="vh-stage-i is-lit" data-stage-i>
					<span class="vh-node" aria-hidden="true"></span>
					<h3>Tickets</h3>
					<p>You split it, or plan them with an agent.</p>
					<pre class="vh-pre">{tickets.map((t, i) => (
						<span class="row">{i === 2 ? (
							<span class="mark" data-t03 data-state="done"><span class="m-pend c-d">○</span><span class="m-cur c-a">●</span><span class="m-done c-o">✓</span></span>
						) : (
							<span class={i < 2 ? "c-o" : "c-d"}>{i < 2 ? "✓" : "○"}</span>
						)} <span class={i === 2 ? "c-x" : ""}>{t}</span></span>
					))}</pre>
				</li>
				<li class="vh-stage-i vh-stage-wide is-lit" data-stage-i>
					<span class="vh-node" aria-hidden="true"></span>
					<h3>Steps</h3>
					<p>Your Workflow, on the Ticket's own branch.</p>
					<pre class="vh-pre">{steps.map((s, i) => (
						<span class="row" data-step={i} data-state="done"><span class="mark"><span class="m-pend c-d">·</span><span class="m-cur c-a">●</span><span class="m-done c-o">✓</span></span> {s.id.padEnd(13)}<span class="c-d">{s.type.padEnd(6)}</span><span class="meta c-d">{s.took.padStart(6)} {s.cost.padStart(5)}</span></span>
					))}</pre>
				</li>
				<li class="vh-stage-i is-lit" data-stage-i>
					<span class="vh-node" aria-hidden="true"></span>
					<h3>Commits</h3>
					<p>One per Ticket, on <code>vago/gift-cards</code>.</p>
					<pre class="vh-pre"><span class="row vh-landed" data-landed data-state="done"><span class="c-a">a83d5c1</span> 03 balance page</span>{commits.map(([h, m]) => <span class="row"><span class="c-d">{h}</span> {m}</span>)}</pre>
				</li>
				<li class="vh-stage-i is-lit" data-stage-i>
					<span class="vh-node" aria-hidden="true"></span>
					<h3>PR</h3>
					<p>Yours to review and merge.</p>
					<pre class="vh-pre" data-pr data-state="done"><span class="row c-x">gift-cards #37</span><span class="row c-d">Workflow small</span><span class="row"><span class="swap"><span class="v-old">2 of 5 Tickets</span><span class="v-new">3 of 5 Tickets</span></span></span><span class="row"><span class="swap"><span class="v-old">33m, $2.01</span><span class="v-new">48m, $3.18</span></span></span></pre>
				</li>
			</ol>
			<p class="vh-limit">One Ticket at a time, for now. Goals can run side by side; the Tickets of one Goal can't.</p>
		</div>
	</section>

	<section class="vh-wf" id="vh-workflow" aria-labelledby="vh-wf-h">
		<div class="vh-wf-head" data-rise>
			<h2 id="vh-wf-h">Your Workflow is a short file</h2>
			<div class="vh-wf-text">
				<p class="vh-wf-lede">
					Vago has opinions about how a Workflow runs and none about what it is. That part is yours, per Project, in <code>.vago/workflows/</code>.
				</p>
				<div class="vh-wf-split">
					<div>
						<h3>Vago takes care of</h3>
						<ul>
							<li>A worktree per Goal, so your checkout stays yours</li>
							<li>Retries that resume the agent's own session</li>
							<li>Ticket and Run state in plain files in your repo</li>
							<li>Picking up a stuck Ticket, or a crashed run, where it stopped</li>
						</ul>
					</div>
					<div>
						<h3>You decide</h3>
						<ul>
							<li>The Steps and their order</li>
							<li>Every prompt an agent Step gets</li>
							<li>Which agent and model, per Step</li>
							<li>The scripts that branch, check and merge</li>
						</ul>
					</div>
				</div>
			</div>
		</div>

		<div class="vh-wf-body">
			<div class="vh-file-wrap" data-rise>
				<p class="vh-file-lede">
					It ships two to start from. A solo project can commit straight to <code>main</code>, a work repo can wait for reviews and checks, and an open source contribution can follow that project's rules without anything personal landing in its repo.
				</p>
				<div class="vh-tabs" role="tablist" aria-label="Starter Workflows">
					{starterFiles.map((w, i) => (
						<button type="button" role="tab" id={`vh-tab-${i}`} aria-controls={`vh-wf-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tab={i}>{w.file}</button>
					))}
				</div>
				{starterFiles.map((w, i) => (
					<div class="vh-panel" role="tabpanel" id={`vh-wf-${i}`} aria-labelledby={`vh-tab-${i}`} hidden={i !== 0} data-panel={i}>
						<p class="vh-file-name"><code>.vago/workflows/{w.file}</code>. {w.blurb}</p>
						<pre class="vh-file" data-file={w.file} aria-label={`The ${w.file} Workflow, without its comments`}>{w.blocks.map((b) => (
							<span class={`blk blk-${b.kind}`} data-block={(w.replayed && b.step) || undefined} data-state={w.replayed && b.kind === "step" ? "pend" : undefined}>{b.lines.map((l) => <span class="ln">{l}</span>)}{w.replayed && b.kind === "skip" && <span class="ln c-d"># skipped: 03 isn't the Goal's last Ticket</span>}</span>
						))}</pre>
					</div>
				))}
			</div>
			<div class="vh-wf-tui">
				<div class="vh-wf-sticky">
					<p class="vh-now" aria-live="polite"><span class="vh-now-dot" aria-hidden="true"></span><span data-now>gift-cards, Ticket 03</span></p>
					<LiveTui id="vh-flow-tui" class="vh-flow-tui" moment="ticket-steps" tour={false} keys={false} caption={false} />
					<aside class="vh-fail" aria-labelledby="vh-fail-h">
						<h3 id="vh-fail-h">When a Step fails</h3>
						<p>
							Each retry waits 1, 1 and then 5 minutes, and resumes the agent's own session. A run that crashed is picked up the same way: the next <code>vago run</code> starts at the Step it was on.
						</p>
						<button type="button" class="vh-text-btn" data-show-stuck aria-pressed="false">Show a stuck Goal in the TUI</button>
					</aside>
				</div>
			</div>
		</div>
	</section>

	<section class="vh-install" id="vh-install" aria-labelledby="vh-install-h">
		<div class="vh-install-head" data-rise>
			<h2 id="vh-install-h">Try it on a small Goal</h2>
			<p>Pick something you'd finish in an afternoon, write the Goal, split it into two or three Tickets and run it with the small Workflow.</p>
		</div>
		<div class="vh-install-grid" data-rise>
			<div>
				<h3>Install</h3>
				<pre class="vh-code"><span class="ln"><span class="c-d">$</span> git clone git@github.com:julianbonomini/vago.git</span><span class="ln"><span class="c-d">$</span> cd vago && bun install && bun run reinstall</span><span class="ln"><span class="c-d">$</span> cd ~/code/your-project && vago init</span></pre>
				<p class="vh-install-note"><code>reinstall</code> builds <code>vago</code> into <code>~/.local/bin</code>. <code>init</code> copies the starter Workflows, prompts and scripts into <code>.vago/</code>.</p>
			</div>
			<div>
				<h3>First Goal</h3>
				<pre class="vh-code"><span class="ln"><span class="c-d">$</span> vago goal new search --workflow small --body-file goal.md</span><span class="ln"><span class="c-d">$</span> vago ticket add search index --body-file index.md</span><span class="ln"><span class="c-d">$</span> vago run search</span></pre>
				<p class="vh-install-note">Then run <code>vago</code> on its own to watch it, and go do something else.</p>
			</div>
		</div>
		<ul class="vh-limits" data-rise>
			<li>It's an Alpha. When the retries run out, it's your turn.</li>
			<li>You need Bun to build it, Claude Code or Codex to run agent Steps, and <code>gh</code> for the PR.</li>
			<li>The starter Workflows are the ones I use. Change them, or write your own.</li>
		</ul>
	</section>

	<footer class="vh-foot">
		<div class="vh-foot-row">
			<p><i>Vago</i> is Spanish for lazy. You're the lazy one. A personal project, MIT licensed.</p>
			<nav aria-label="Footer">
				<a href={github}>GitHub</a>
				<a href="#">Docs</a>
				<a href={`${github}/blob/main/LICENSE`}>License</a>
				<ThemeToggle />
			</nav>
		</div>
		<p class="vh-foot-word" aria-hidden="true">vago</p>
	</footer>
</div>

<script>
	import { mountVariantH } from "./h/page.ts";
	const root = document.querySelector<HTMLElement>(".vh");
	if (root) mountVariantH(root);
</script>

<style is:global>
	.vh { min-height: 100vh; --vh-max: 1600px; }
	@media (min-width: 1000px) { .vh { --v-gutter: 40px; } }
	.vh a { color: inherit; }
	.vh code { font-family: var(--v-mono); font-size: 0.86em; color: var(--v-bright); }
	.vh button { font: inherit; color: inherit; }
	.vh h2 {
		font-size: var(--v-fs-h2);
		letter-spacing: var(--v-track-h2);
		line-height: 1.04;
		font-weight: var(--v-weight-head);
		color: var(--v-bright);
		margin: 0;
	}
	.vh h3 { margin: 0; font-size: var(--v-fs-h3); font-weight: 600; color: var(--v-bright); letter-spacing: -0.01em; }
	.vh .c-d { color: var(--v-grey); }
	.vh .c-x { color: var(--v-bright); }
	.vh .c-a { color: var(--v-accent); }
	.vh .c-o { color: var(--v-ok); }
	.vh .c-b { color: var(--v-bad); }
	.vh :focus-visible { outline: 2px solid var(--v-accent); outline-offset: 3px; }

	/* Header and footer share the band: a soft shade of the page, not an inversion. */
	.vh-top { background: var(--v-band); position: relative; z-index: 4; }
	.vh-top-in {
		max-width: var(--vh-max);
		margin: 0 auto;
		padding: 16px var(--v-gutter);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
	}
	.vh-word { font-family: var(--v-mono); font-weight: 700; color: var(--v-bright); letter-spacing: -0.02em; text-decoration: none; font-size: 20px; }
	.vh-word::after {
		content: "";
		display: inline-block;
		width: 0.5em;
		height: 0.16em;
		margin-left: 0.12em;
		background: var(--v-accent-fill);
		vertical-align: baseline;
	}
	.vh-top nav { display: flex; gap: 26px; font-size: 15px; align-items: center; }
	.vh-top nav a { text-decoration: none; color: var(--v-fg); transition: color 0.15s; }
	.vh-top nav a:hover { color: var(--v-accent); }

	/* Hero stage: a plain layout by default; .is-pinned makes it the pull-back. */
	.vh-sticky {
		max-width: var(--vh-max);
		margin: 0 auto;
		padding: 36px var(--v-gutter) 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas: "copy" "slot" "side";
	}
	.vh-copy {
		grid-area: copy;
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: var(--v-gap);
		align-items: end;
		padding-bottom: 36px;
	}
	.vh h1 {
		font-size: var(--v-fs-display);
		line-height: var(--v-lh-display);
		letter-spacing: var(--v-track-display);
		font-weight: var(--v-weight-head);
		color: var(--v-bright);
		margin: 0;
	}
	.vh-sub { font-size: clamp(17px, 1.4vw, 20px); color: var(--v-fg); margin: 0; max-width: 34ch; line-height: 1.45; }
	.vh-ctas { display: flex; gap: 26px; align-items: center; margin-top: 22px; }
	.vh-btn {
		background: var(--v-accent-fill);
		text-decoration: none;
		font-weight: 600;
		padding: 11px 22px;
		border-radius: var(--v-radius);
		transition: transform 0.15s var(--v-ease), background 0.15s;
	}
	.vh .vh-btn { color: var(--v-on-accent); }
	.vh-btn:hover { background: var(--v-accent-hover); }
	.vh-btn:active { transform: scale(0.97); }
	.vh-link { text-decoration: none; border-bottom: 1px solid var(--v-line-strong); padding-bottom: 2px; transition: border-color 0.15s; }
	.vh-link:hover { border-color: var(--v-accent); }

	.vh-slot { grid-area: slot; min-width: 0; }
	.vh-side { grid-area: side; display: flex; flex-direction: column; padding-top: 40px; }
	.vh-side h2 { font-size: clamp(26px, 2.4vw, 34px); }
	.vh-side-note { margin: 10px 0 0; font-size: var(--v-fs-small); color: var(--v-grey); max-width: 44ch; }

	.vh-parts { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 2px; }
	.vh-part {
		all: unset;
		box-sizing: border-box;
		cursor: pointer;
		display: block;
		width: 100%;
		padding: 10px 14px 10px 16px;
		border-radius: var(--v-radius);
		position: relative;
		transition: background 0.25s var(--v-ease);
	}
	.vh-part::before {
		content: "";
		position: absolute;
		left: 0;
		top: 12px;
		bottom: 12px;
		width: 3px;
		border-radius: 2px;
		background: var(--v-accent-fill);
		transform: scaleY(0);
		transition: transform 0.35s var(--v-ease);
	}
	.vh-part:hover { background: var(--v-raised); }
	.vh-part:focus-visible { outline: 2px solid var(--v-accent); outline-offset: 2px; }
	.vh-part-name { display: block; font-weight: 600; color: var(--v-grey); font-size: 17px; transition: color 0.2s; }
	.vh-part-text {
		display: grid;
		grid-template-rows: 0fr;
		font-size: 15px;
