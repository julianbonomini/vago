---
// PROTOTYPE: floating variant switcher. Not part of any design being judged.
type Props = { variants: { key: string; name: string }[] };
const { variants } = Astro.props;
---
{import.meta.env.DEV && (
  <div id="proto-switcher" data-variants={JSON.stringify(variants)}>
    <button type="button" data-step="-1" aria-label="Previous variant">←</button>
    <span id="proto-label"></span>
    <button type="button" data-step="1" aria-label="Next variant">→</button>
  </div>
)}
<script>
  const bar = document.getElementById("proto-switcher");
  const variants: { key: string; name: string }[] = JSON.parse(
    bar?.dataset.variants ?? document.querySelector("[data-proto-variants]")?.getAttribute("data-proto-variants") ?? "[]",
  );
  function show(key: string) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-variant]")) {
      el.hidden = el.dataset.variant !== key;
    }
    const v = variants.find((x) => x.key === key);
    const label = document.getElementById("proto-label");
    if (label && v) label.textContent = `${v.key} (${v.name})`;
  }
  function current() {
    const key = new URLSearchParams(location.search).get("variant") ?? "A";
    return variants.some((v) => v.key === key) ? key : "A";
  }
  function step(by: number) {
    const i = variants.findIndex((v) => v.key === current());
    const next = variants[(i + by + variants.length) % variants.length];
    if (!next) return;
    const url = new URL(location.href);
    url.searchParams.set("variant", next.key);
    history.replaceState(null, "", url);
    show(next.key);
    window.scrollTo(0, 0);
  }
  bar?.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
    b.addEventListener("click", () => step(Number(b.dataset.step))),
  );
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement | null;
    if (t?.closest("input, textarea, [contenteditable]")) return;
    if (e.key === "ArrowLeft") step(-1);
    if (e.key === "ArrowRight") step(1);
  });
  show(current());
</script>
<style is:global>
  #proto-switcher {
    position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
    z-index: 9999; display: flex; align-items: center; gap: 10px;
    padding: 6px 10px; border-radius: 999px;
    background: #fff; color: #111; font: 600 13px/1 system-ui, sans-serif;
    box-shadow: 0 4px 20px rgba(0,0,0,.45); border: 2px solid #ff00aa;
  }
  #proto-switcher button {
    all: unset; cursor: pointer; padding: 4px 8px; border-radius: 999px;
  }
  #proto-switcher button:hover { background: #eee; }
</style>
