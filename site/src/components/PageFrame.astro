---
// Every page's document: its head, the theme set before paint, the header band with the wordmark, nav and
// theme toggle, the page's own content, and the footer band. A page is <PageFrame title=...>content</PageFrame>.
import "@fontsource-variable/geist";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/tokens.css";
import { repoUrl, siteUrl } from "../site.ts";
import { themeStorageKey } from "../theme.ts";
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
	/** The page's name, shown before "· Vago" in the tab; the landing page leaves it out. */
	title?: string;
	description?: string;
};

const {
	title,
	description = "Vago runs your Workflow on a Goal in your repo, one Ticket at a time, and leaves you a PR.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title ? `${title} · Vago` : "Vago"}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, siteUrl)} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{/* Before paint, so a dark page never flashes light. Until the visitor picks a theme it follows the
		    system, also when that changes. Storage can be blocked; then the system decides. */}
		<script is:inline define:vars={{ themeStorageKey }}>
			const system = matchMedia("(prefers-color-scheme: dark)");
			const applyTheme = () => {
				let picked = null;
				try {
					picked = localStorage.getItem(themeStorageKey);
				} catch {}
				const dark = picked ? picked === "dark" : system.matches;
				document.documentElement.dataset.theme = dark ? "dark" : "light";
			};
			applyTheme();
			system.addEventListener("change", applyTheme);
		</script>
	</head>
	<body>
		<header class="v-top">
			<div class="v-top-in">
				<a class="v-word" href="/" aria-label="Vago, home">vago</a>
				<nav aria-label="Main">
					<a href={repoUrl}>GitHub</a>
					<ThemeToggle />
				</nav>
			</div>
		</header>

		<main class="v-main">
			<slot />
		</main>

		<footer class="v-foot">
			<div class="v-foot-row">
				<p><i>Vago</i> is Spanish for lazy. You're the lazy one. A personal project, MIT licensed.</p>
				<nav aria-label="Footer">
					<a href={repoUrl}>GitHub</a>
					<a href={`${repoUrl}/blob/main/LICENSE`}>License</a>
				</nav>
			</div>
			<p class="v-foot-word" aria-hidden="true">vago</p>
		</footer>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: var(--v-bg);
		color: var(--v-fg);
		font-family: var(--v-sans);
		font-size: var(--v-fs-body);
		line-height: var(--v-lh-body);
		-webkit-font-smoothing: antialiased;
		overflow-x: clip;
		transition:
			background-color 0.3s var(--v-ease),
			color 0.3s var(--v-ease);
	}
	a {
		color: inherit;
	}
	:focus-visible {
		outline: 2px solid var(--v-accent);
		outline-offset: 3px;
	}
	@media (prefers-reduced-motion: reduce) {
		body {
			transition: none;
		}
	}
</style>

<style>
	/* Header and footer share the band: a soft shade of the page, not an inversion. */
	.v-top {
		padding: 16px var(--v-gutter);
		background: var(--v-band);
	}
	.v-top-in {
		max-width: var(--v-max);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
	}
	.v-word {
		font-family: var(--v-mono);
		font-weight: 700;
		font-size: 20px;
		letter-spacing: -0.02em;
		color: var(--v-bright);
		text-decoration: none;
	}
	.v-word::after {
		content: "";
		display: inline-block;
		width: 0.5em;
		height: 0.16em;
		margin-left: 0.12em;
		background: var(--v-accent-fill);
	}
	nav {
		display: flex;
		gap: 22px;
		align-items: center;
		font-size: 15px;
	}
	nav a {
		text-decoration: none;
		transition: color 0.15s;
	}
	nav a:hover {
		color: var(--v-accent);
	}

	.v-main {
		flex: 1;
		width: min(100% - 2 * var(--v-gutter), var(--v-max));
		margin: 0 auto;
	}

	/* The footer: the name returns at full width, on the band. */
	.v-foot {
		margin-top: var(--v-section);
		padding: 40px var(--v-gutter) 0;
		background: var(--v-band);
		overflow: hidden;
	}
	.v-foot-row {
		max-width: var(--v-max);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 24px;
		font-size: 15px;
	}
	.v-foot-row p {
		margin: 0;
	}
	.v-foot-word {
		max-width: var(--v-max);
		margin: 0.1em auto 0;
		padding-bottom: 0.06em;
		font-family: var(--v-mono);
		font-weight: 700;
		font-size: min(26vw, 420px);
		line-height: 0.72;
		letter-spacing: -0.06em;
		color: var(--v-band-word);
		white-space: nowrap;
	}
	.v-foot-word::after {
		content: "";
		display: inline-block;
		width: 0.42em;
		height: 0.52em;
		margin-left: 0.1em;
		background: var(--v-accent-fill);
	}
	@media (prefers-reduced-motion: no-preference) {
		.v-foot-word::after {
			animation: v-caret 1.1s steps(1) infinite;
		}
	}
	@keyframes v-caret {
		50% {
			opacity: 0;
		}
	}
	@media (max-width: 640px) {
		.v-foot-row {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
